@{
    ViewData["Title"] = "Instructor Login";
}

<div class="login-page">

    <div class="login-shell">

        <!-- LEFT SIDE -->
        <section class="login-intro">

            <div class="login-intro-content">

                <div class="login-badge">
                    INSTRUCTOR INFORMATION SYSTEM
                </div>

                <div class="login-symbol">IIS</div>

                <h1>
                    Manage your work
                    <span>with confidence.</span>
                </h1>

                <p>
                    A centralized workspace for instructor
                    information, teaching records, and
                    course management.
                </p>

                <div class="login-feature">
                    <span class="feature-mark">✓</span>
                    <span>Organized instructor records</span>
                </div>

                <div class="login-feature">
                    <span class="feature-mark">✓</span>
                    <span>Easy course management</span>
                </div>

                <div class="login-feature">
                    <span class="feature-mark">✓</span>
                    <span>Secure account sign-in</span>
                </div>

            </div>

            <div class="login-intro-footer">
                Designed for efficient academic management.
            </div>

        </section>

        <!-- RIGHT SIDE -->
        <section class="login-form-section">

            <div class="login-form-content">

                <div class="login-mobile-brand">
                    IIS • Instructor Information System
                </div>

                <div class="login-heading">
                    <div class="login-heading-icon">↗</div>

                    <h2>Welcome back</h2>

                    <p>
                        Sign in to access your instructor
                        dashboard.
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    <div class="alert-error">
                        @ViewBag.Message
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="login-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@Context.Request.Query["ReturnUrl"]" />

                    <div class="form-field">
                        <label for="email">
                            Email Address or Instructor ID
                        </label>

                        <input type="text"
                               id="email"
                               name="email"
                               autocomplete="username"
                               placeholder="Enter your email or ID"
                               required />
                    </div>

                    <div class="form-field">
                        <label for="password">
                            Password
                        </label>

                        <input type="password"
                               id="password"
                               name="password"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               required />
                    </div>

                    <button type="submit"
                            class="login-submit">
                        Sign In
                        <span aria-hidden="true">→</span>
                    </button>

                </form>

                <p class="login-register-text">
                    New to the system?

                    <a asp-controller="Account"
                       asp-action="Register">
                        Create an account
                    </a>
                </p>

                <div class="login-security">
                    Your session is protected by account authentication.
                </div>

            </div>

        </section>

    </div>

</div>
