@model IReadOnlyList<InstructorInformationSystem.Models.Course>

@{
    ViewData["Title"] = "Instructor Dashboard";
    ViewData["WideLayout"] = true;

    string firstName = ViewBag.FirstName as string ?? "";
    string lastName = ViewBag.LastName as string ?? "";

    string fullName = $"{firstName} {lastName}".Trim();

    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = "Instructor";
    }

    int totalCourses = Model.Count;
    int totalUnits = Model.Sum(c => c.Units);
    int totalInstructors = ViewBag.TotalInstructors ?? 0;
}

<div class="dashboard-container">

    <!-- WELCOME SECTION -->
    <section class="dashboard-welcome">

        <div>
            <p class="dashboard-subtitle">
                INSTRUCTOR INFORMATION SYSTEM
            </p>

            <h1>Welcome, @fullName!</h1>

            <p>
                Manage instructor information,
                courses, and teaching records
                in one place.
            </p>
        </div>

        <a asp-controller="Instructor"
           asp-action="Index"
           class="dashboard-btn-white">
            View Instructors
        </a>

    </section>

    <!-- SUMMARY CARDS -->
    <section class="dashboard-stats">

        <div class="stat-card">
            <div class="stat-icon">👨‍🏫</div>
            <h3>Total Instructors</h3>
            <h2>@totalInstructors</h2>
            <p>Saved instructor records</p>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📚</div>
            <h3>Total Courses</h3>
            <h2>@totalCourses</h2>
            <p>Available course records</p>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🎓</div>
            <h3>Total Units</h3>
            <h2>@totalUnits</h2>
            <p>Combined course units</p>
        </div>

    </section>

    <!-- INSTRUCTOR MANAGEMENT -->
    <section class="dashboard-section">

        <div class="section-header">
            <div>
                <h2>Instructor Information Management</h2>
                <p>
                    Manage instructor records saved
                    in the SQLite database.
                </p>
            </div>

            <a asp-controller="Instructor"
               asp-action="Index"
               class="dashboard-btn-outline">
                View All Instructors
            </a>
        </div>

        <div class="quick-actions">

            <a asp-controller="Instructor"
               asp-action="Index"
               class="action-card">

                <div class="action-icon">👨‍🏫</div>
                <h3>Instructor Records</h3>

                <p>
                    View instructor information,
                    including designation, majorship,
                    bachelor degree, and contact details.
                </p>
            </a>

            <a asp-controller="Instructor"
               asp-action="Create"
               class="action-card">

                <div class="action-icon">➕</div>
                <h3>Add New Instructor</h3>

                <p>
                    Create a new instructor record
                    and save the information
                    permanently in SQLite.
                </p>
            </a>

        </div>

    </section>

    <!-- COURSE OVERVIEW -->
    <section class="dashboard-section">

        <div class="section-header">
            <div>
                <h2>Course Overview</h2>
                <p>View and manage existing courses.</p>
            </div>

            <a asp-controller="Course"
               asp-action="Index"
               class="dashboard-btn-outline">
                View All Courses
            </a>
        </div>

        <div class="dashboard-table-container">

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Units</th>
                        <th>Schedule</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count > 0)
                    {
                        foreach (var course in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@course.CourseCode</strong>
                                </td>

                                <td>@course.CourseName</td>
                                <td>@course.Units</td>
                                <td>@course.Schedule</td>

                                <td>
                                    <div style="display:flex;
                                        flex-wrap:wrap;
                                        gap:6px;">

                                        <a asp-controller="Course"
                                           asp-action="Details"
                                           asp-route-id="@course.Id"
                                           class="dashboard-edit-btn">
                                            Details
                                        </a>

                                        <a asp-controller="Course"
                                           asp-action="Edit"
                                           asp-route-id="@course.Id"
                                           class="dashboard-edit-btn">
                                            Edit
                                        </a>

                                        <a asp-controller="Course"
                                           asp-action="Delete"
                                           asp-route-id="@course.Id"
                                           class="dashboard-edit-btn">
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="empty-message">
                                No courses available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </section>

    <!-- QUICK ACTIONS -->
    <section class="dashboard-section">

        <div class="section-header">
            <div>
                <h2>Quick Actions</h2>
                <p>
                    Quickly access common management tasks.
                </p>
            </div>
        </div>

        <div class="quick-actions">

            <a asp-controller="Course"
               asp-action="Create"
               class="action-card">

                <div class="action-icon">📘</div>
                <h3>Add New Course</h3>
                <p>
                    Create a course record with
                    its units and schedule.
                </p>
            </a>

            <a asp-controller="Course"
               asp-action="Index"
               class="action-card">

                <div class="action-icon">📂</div>
                <h3>Manage Courses</h3>
                <p>
                    View, edit, and delete
                    existing course records.
                </p>
            </a>

        </div>

    </section>

</div>
