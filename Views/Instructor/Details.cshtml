@model InstructorInformationSystem.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="card">

    <h2>Instructor Details</h2>

    <p>Complete information of the selected instructor.</p>

    <div style="overflow-x:auto;">
        <table>
            <tbody>
                <tr>
                    <th>Instructor ID</th>
                    <td>@Html.DisplayFor(m => m.InstructorID)</td>
                </tr>
                <tr>
                    <th>Full Name</th>
                    <td>@Model.FullName</td>
                </tr>
                <tr>
                    <th>Age</th>
                    <td>@Html.DisplayFor(m => m.Age)</td>
                </tr>
                <tr>
                    <th>Address</th>
                    <td>@Html.DisplayFor(m => m.Address)</td>
                </tr>
                <tr>
                    <th>Designation</th>
                    <td>@Html.DisplayFor(m => m.Designation)</td>
                </tr>
                <tr>
                    <th>Gender</th>
                    <td>@Html.DisplayFor(m => m.Gender)</td>
                </tr>
                <tr>
                    <th>Contact Number</th>
                    <td>@Html.DisplayFor(m => m.ContactNumber)</td>
                </tr>
                <tr>
                    <th>Majorship</th>
                    <td>@Html.DisplayFor(m => m.Majorship)</td>
                </tr>
                <tr>
                    <th>Bachelor Degree</th>
                    <td>@Html.DisplayFor(m => m.BachelorDegree)</td>
                </tr>
                <tr>
                    <th>E-mail Address</th>
                    <td>@Html.DisplayFor(m => m.Email)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="instructor-page-actions">

        <a asp-controller="Instructor"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="instructor-action"
           style="background:maroon;">
            Edit Instructor
        </a>

        <a asp-controller="Instructor"
           asp-action="Index"
           class="instructor-action"
           style="background:#555;">
            Back to List
        </a>

    </div>
</div>
