@model InstructorInformationSystem.Models.Instructor

@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="card">

    <h2>Edit Instructor Information</h2>

    <p>Update the selected instructor's information.</p>

    <form asp-controller="Instructor"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div>
            <label asp-for="InstructorID"></label>
            <input asp-for="InstructorID" />
            <span asp-validation-for="InstructorID"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" />
            <span asp-validation-for="FirstName"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="LastName"></label>
            <input asp-for="LastName" />
            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Age"></label>
            <input asp-for="Age"
                   type="number" min="18" max="100" />
            <span asp-validation-for="Age"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Address"></label>
            <textarea asp-for="Address" rows="3"></textarea>
            <span asp-validation-for="Address"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Designation"></label>
            <input asp-for="Designation" />
            <span asp-validation-for="Designation"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Gender"></label>
            <select asp-for="Gender" class="instructor-select">
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Non-binary">Non-binary</option>
                <option value="Prefer not to say">Prefer not to say</option>
            </select>
            <span asp-validation-for="Gender"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="ContactNumber"></label>
            <input asp-for="ContactNumber"
                   type="tel" maxlength="11" />
            <span asp-validation-for="ContactNumber"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Majorship"></label>
            <input asp-for="Majorship" />
            <span asp-validation-for="Majorship"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="BachelorDegree"></label>
            <input asp-for="BachelorDegree" />
            <span asp-validation-for="BachelorDegree"
                  class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <button type="submit">Update Instructor</button>

    </form>

    <p style="margin-top:20px;">
        <a asp-controller="Instructor"
           asp-action="Index">Back to List</a>
    </p>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
