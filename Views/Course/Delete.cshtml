
@model InstructorInformationSystem.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="card">
    <h2>Delete Course</h2>

    <p style="color:#dc3545; font-weight:bold;">
        Are you sure you want to delete this course?
    </p>

    <table>
        <tr>
            <th>Course Code</th>
            <td>@Html.DisplayFor(model => model.CourseCode)</td>
        </tr>
        <tr>
            <th>Course Name</th>
            <td>@Html.DisplayFor(model => model.CourseName)</td>
        </tr>
        <tr>
            <th>Units</th>
            <td>@Html.DisplayFor(model => model.Units)</td>
        </tr>
        <tr>
            <th>Schedule</th>
            <td>@Html.DisplayFor(model => model.Schedule)</td>
        </tr>
    </table>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          style="margin-top:25px;">

        @Html.AntiForgeryToken()

        <button type="submit"
                style="background:#dc3545;">
            Confirm Delete
        </button>
    </form>

    <div style="margin-top:15px;">
        <a asp-action="Index">Cancel and Back to List</a>
    </div>
</div>
